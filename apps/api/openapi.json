{
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveDto_Output"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    },
    "/v1/me": {
      "get": {
        "operationId": "MeController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Valid token, but missing the access_as_user scope or the required permission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ],
        "tags": [
          "access"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "operationId": "ClientConfigController_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Client configuration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponseDto_Output"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or invalid token.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Valid token, but missing the access_as_user scope or the required permission.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "entra": []
          }
        ],
        "tags": [
          "config"
        ]
      }
    }
  },
  "info": {
    "title": "Nexus API",
    "description": "Read-only monitoring API for Innovo construction sites. Errors are application/problem+json (RFC 9457).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "entra": {
        "scheme": "bearer",
        "bearerFormat": "Entra ID access token",
        "type": "http"
      }
    },
    "schemas": {
      "HealthLiveDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "MeResponseDto_Output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "admin",
                "leadership",
                "project_manager",
                "site_user",
                "viewer"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "portfolio.read",
                "project.read",
                "asset.read",
                "telemetry.history",
                "events.read",
                "explorer.use",
                "explorer.export",
                "admin.users.manage",
                "admin.projects.manage",
                "admin.integrations",
                "admin.settings",
                "audit.read",
                "cctv.view",
                "media.read",
                "bim.view"
              ]
            }
          },
          "projectScope": {
            "type": "object",
            "properties": {
              "all": {
                "type": "boolean"
              },
              "projectIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              }
            },
            "required": [
              "all",
              "projectIds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "roles",
          "permissions",
          "projectScope"
        ],
        "additionalProperties": false
      },
      "ConfigResponseDto_Output": {
        "type": "object",
        "properties": {
          "arcgis": {
            "type": "object",
            "properties": {
              "apiKey": {
                "type": "string"
              },
              "basemaps": {
                "type": "object",
                "properties": {
                  "map2d": {
                    "type": "string",
                    "minLength": 1
                  },
                  "satellite": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scene3d": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "map2d",
                  "satellite",
                  "scene3d"
                ],
                "additionalProperties": false
              },
              "extent": {
                "type": "object",
                "properties": {
                  "xmin": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "ymin": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "xmax": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "ymax": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                },
                "required": [
                  "xmin",
                  "ymin",
                  "xmax",
                  "ymax"
                ],
                "additionalProperties": false
              },
              "initialView": {
                "type": "object",
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "zoom": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 24
                  }
                },
                "required": [
                  "latitude",
                  "longitude",
                  "zoom"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "apiKey",
              "basemaps",
              "extent",
              "initialView"
            ],
            "additionalProperties": false
          },
          "enums": {
            "type": "object",
            "properties": {
              "projectStates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "displayStatuses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "key",
                    "label"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "projectStates",
              "displayStatuses"
            ],
            "additionalProperties": false
          },
          "featureFlags": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "arcgis",
          "enums",
          "featureFlags"
        ],
        "additionalProperties": false
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference for the problem type; about:blank for plain HTTP errors."
          },
          "title": {
            "type": "string",
            "description": "Short summary; the HTTP status phrase."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation of this occurrence."
          },
          "correlationId": {
            "description": "Echo of X-Correlation-Id, or the request id. Quote it when reporting a problem.",
            "type": "string"
          },
          "errors": {
            "description": "Field-level failures. Present on 422 only.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      }
    }
  }
}
