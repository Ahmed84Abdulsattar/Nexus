{
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveDto_Output"
                }
              }
            }
          }
        },
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Nexus API",
    "description": "Read-only monitoring API for Innovo construction sites. Errors are application/problem+json (RFC 9457).",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "entra": {
        "scheme": "bearer",
        "bearerFormat": "Entra ID access token",
        "type": "http"
      }
    },
    "schemas": {
      "HealthLiveDto_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ProblemFieldError": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ]
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "URI reference for the problem type; about:blank for plain HTTP errors."
          },
          "title": {
            "type": "string",
            "description": "Short summary; the HTTP status phrase."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "HTTP status code."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable explanation of this occurrence."
          },
          "correlationId": {
            "description": "Echo of X-Correlation-Id, or the request id. Quote it when reporting a problem.",
            "type": "string"
          },
          "errors": {
            "description": "Field-level failures. Present on 422 only.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ]
      }
    }
  }
}
