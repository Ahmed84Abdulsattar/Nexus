{
  "name": "@nexus/worker",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS standalone worker. Placeholder: logs startup, runs no jobs, makes no DATOMS calls.",
  "type": "module",
  "scripts": {
    "dev": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:"
  },
  "devDependencies": {
    "@nexus/config": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@types/node": "catalog:",
    "@swc-node/register": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
