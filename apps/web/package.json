{
  "name": "@nexus/web",
  "version": "0.0.0",
  "private": true,
  "description": "React 19 + Vite SPA. Routing shell with lazy placeholder pages.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
    "measure:map": "node scripts/measure-map-load.mjs",
    "api:generate": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@arcgis/core": "catalog:",
    "@fontsource/poppins": "catalog:",
    "@nexus/shared": "workspace:*",
    "@radix-ui/react-dialog": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "@radix-ui/react-tabs": "catalog:",
    "@tanstack/react-query": "catalog:",
    "openapi-fetch": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@nexus/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "msw": "catalog:",
    "openapi-typescript": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
