{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "description": "Nexus by Innovo: read-only construction site monitoring platform",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "openapi:generate": "pnpm --filter @nexus/shared build && pnpm --filter @nexus/db build && pnpm --filter @nexus/api build && pnpm --filter @nexus/web api:generate",
    "dev:local": "node scripts/dev-local.mjs",
    "db:migrate": "pnpm --filter @nexus/db migrate",
    "db:check": "pnpm --filter @nexus/db check",
    "db:seed": "pnpm --filter @nexus/db seed",
    "db:seed:scale": "pnpm --filter @nexus/db seed:scale",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,css,html,md}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
