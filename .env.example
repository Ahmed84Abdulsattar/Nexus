# Nexus environment variables. The single list is docs/04-tech-stack.md ("Environment variables").
# Copy to .env (git-ignored) and fill in. Never commit real values, tokens or keys.
# Values for local development are described in docs/04; secrets come from Key Vault in Azure.

# all
NODE_ENV=
APP_ENV=

# database: one login per process, each with its own least-privilege role (docs/04, docs/06 section 9)
DATABASE_URL=
WORKER_DATABASE_URL=
DATABASE_ADMIN_URL=
DATABASE_POOL_MAX=
# tests and tools only
TEST_DATABASE_ADMIN_URL=
PG_DUMP=

# Entra ID (api; web uses the VITE_ twins)
ENTRA_TENANT_ID=
VITE_ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_AUDIENCE=
ENTRA_JWKS_URL=
VITE_ENTRA_API_SCOPE=
ENTRA_WEB_CLIENT_ID=
VITE_ENTRA_WEB_CLIENT_ID=
AUTH_MODE=

# Key Vault (api, worker)
KEY_VAULT_URI=

# DATOMS (worker, CLI)
DATOMS_BASE_URL=
DATOMS_ORG_ID=
DATOMS_TOKEN=
DATOMS_LIVE=
DATOMS_MONTHLY_CREDIT_ALLOWANCE=

# live push (api, worker, web)
WEB_PUBSUB_ENDPOINT=
WEB_PUBSUB_HUB=
LIVE_MODE=

# ArcGIS
ARCGIS_API_KEY=
# local only, read by the MSW /v1/config mock in Vite dev mode; never set in CI or Azure
VITE_DEV_ARCGIS_API_KEY=

# telemetry and logging
APPLICATIONINSIGHTS_CONNECTION_STRING=
LOG_LEVEL=

# web
VITE_API_BASE_URL=
