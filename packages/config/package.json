{
  "name": "@nexus/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint and Vitest presets, plus tests for the lint boundary rules",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./eslint/boundaries": "./eslint/boundaries.js",
    "./vitest": {
      "types": "./vitest/index.d.ts",
      "default": "./vitest/index.js"
    },
    "./tsconfig/*": "./tsconfig/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-swc": "catalog:",
    "@swc/core": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
