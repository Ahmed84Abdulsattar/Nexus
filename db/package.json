{
  "name": "@nexus/db",
  "version": "0.0.0",
  "private": true,
  "description": "Database toolkit: SQL migrations (node-pg-migrate), seeds, schema check, typed Kysely access, test databases. The SQL itself is in this folder (schema.sql, roles.sql, migrations/, seeds/).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../.env --import @swc-node/register/esm-register scripts/migrate.ts",
    "check": "node --env-file-if-exists=../.env --import @swc-node/register/esm-register scripts/check.ts",
    "seed": "node --env-file-if-exists=../.env --import @swc-node/register/esm-register scripts/seed.ts",
    "seed:scale": "node --env-file-if-exists=../.env --import @swc-node/register/esm-register seeds/scale-100-sites.ts",
    "codegen": "node --env-file-if-exists=../.env --import @swc-node/register/esm-register scripts/codegen.ts"
  },
  "dependencies": {
    "kysely": "catalog:",
    "node-pg-migrate": "catalog:",
    "pg": "catalog:",
    "pg-connection-string": "catalog:"
  },
  "devDependencies": {
    "@nexus/config": "workspace:*",
    "@swc-node/register": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "kysely-codegen": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
